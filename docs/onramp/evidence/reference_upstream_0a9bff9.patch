From 0a9bff9c9290060577977122b943377035e88b2c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?P=C4=93teris=20Caune?= <cuu508@gmail.com>
Date: Mon, 5 Oct 2026 16:18:42 +0300
Subject: [PATCH] Update HTTP notification transports to accept HTTP 205
 responses

cc: #1347
---
 CHANGELOG.md                                 |  1 +
 hc/api/transports.py                         |  2 +-
 hc/integrations/webhook/tests/test_notify.py | 25 ++++++++++++++++++--
 3 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 470ddad9..b589d52a 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,7 @@ All notable changes to this project will be documented in this file.
 ### Improvements
 - Fix project invite email template to mangle URLs in project names
 - Fix transfer request email template to mangle URLs in project names
+- Update HTTP notification transports to accept HTTP 205 (#1347)
 
 ### Bug Fixes
 - Fix the email integration to handle SMTP connection errors gracefully (#1346)
diff --git a/hc/api/transports.py b/hc/api/transports.py
index 4f2f5acd..0e876585 100644
--- a/hc/api/transports.py
+++ b/hc/api/transports.py
@@ -158,7 +158,7 @@ class HttpTransport(Transport):
                 auth=auth,
                 timeout=30,
             )
-            if r.status_code not in (200, 201, 202, 204):
+            if r.status_code not in (200, 201, 202, 204, 205):
                 cls.raise_for_response(r)
         except curl.CurlError as e:
             raise TransportError(e.message)
diff --git a/hc/integrations/webhook/tests/test_notify.py b/hc/integrations/webhook/tests/test_notify.py
index 64cee371..5abe5f4d 100644
--- a/hc/integrations/webhook/tests/test_notify.py
+++ b/hc/integrations/webhook/tests/test_notify.py
@@ -43,7 +43,7 @@ class NotifyWebhookTestCase(BaseTestCase):
         self.flip.new_status = status
 
     @patch("hc.api.transports.curl.request", autospec=True)
-    def test_webhook(self, mock_get: Mock) -> None:
+    def test_it_works(self, mock_get: Mock) -> None:
         definition = {
             "method_down": "GET",
             "url_down": "http://example",
@@ -54,11 +54,32 @@ class NotifyWebhookTestCase(BaseTestCase):
         self._setup_data(json.dumps(definition))
         mock_get.return_value.status_code = 200
 
-        self.channel.notify(self.flip)
+        error = self.channel.notify(self.flip)
+        self.assertEqual(error, "")
+
+        mock_get.assert_called_once()
         args, kwargs = mock_get.call_args
         self.assertEqual(args, ("get", "http://example"))
         self.assertEqual(kwargs["timeout"], 30)
 
+    @patch("hc.api.transports.curl.request", autospec=True)
+    def test_it_handles_http_205(self, mock_get: Mock) -> None:
+        definition = {
+            "method_down": "GET",
+            "url_down": "http://example",
+            "body_down": "",
+            "headers_down": {},
+        }
+
+        self._setup_data(json.dumps(definition))
+        mock_get.return_value.status_code = 205
+
+        error = self.channel.notify(self.flip)
+        self.assertEqual(error, "")
+
+        mock_get.assert_called_once()
+        self.assertEqual(mock_get.call_args.args, ("get", "http://example"))
+
     @patch(
         "hc.api.transports.curl.request",
         autospec=True,
-- 
2.55.0.windows.5

